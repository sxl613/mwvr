BIND_ADDRESS=127.0.0.1
PORT=3000
MEDIA_PATH=/media/videos/

# Optional app-level cookie auth (defense in depth behind Cloudflare Access).
# Leave empty to rely on Access alone.
AUTH_COOKIE_NAME=
AUTH_COOKIE_VALUE=

# Public origin used to build share URLs, e.g. https://canis.example.com
PUBLIC_BASE_URL=http://127.0.0.1:3000

# SQLite share database location (persist on a volume in compose).
SHARE_DB_PATH=./shares.db

# Directory for generated share thumbnails.
THUMB_DIR=./thumbs

# Optional HTML snippet injected at the end of <head> on every page (e.g. analytics).
# Example:
#   ANALYTICS_TAG='<script async src="https://analytics.example.com/script.js" data-website-id="xxxx"></script>'
# Leave empty to disable.
ANALYTICS_TAG=

# Compose-only values:
# MEDIA_HOST_PATH=/video
# TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
